% beamerthemeUOCTFM.sty — tema Beamer para la defensa del TFM (sistema "Vía Accesible")
% Uso: \documentclass[aspectratio=169]{beamer} \usetheme{UOCTFM}
% Logotipo: \logouoc{noulogo.png} (fichero de la plantilla oficial TFM-LaTeX).
% Idioma: \usepackage[spanish]{babel} en el preámbulo.
\ProvidesPackage{beamerthemeUOCTFM}[2026/09/29 v1.0]
\RequirePackage{tfm-estilo}

\mode<presentation>
\usefonttheme{professionalfonts}
\setbeamertemplate{navigation symbols}{}
\setbeamersize{text margin left=10mm, text margin right=10mm}

\def\uoclogofile{}
\newcommand{\logouoc}[1]{\def\uoclogofile{#1}}

% Colores
\setbeamercolor{normal text}{fg=tinta, bg=papel}
\setbeamercolor{structure}{fg=uoc-azul}
\setbeamercolor{frametitle}{fg=uoc-azul, bg=papel}
\setbeamercolor{title}{fg=uoc-azul}
\setbeamercolor{subtitle}{fg=tinta-suave}
\setbeamercolor{author}{fg=tinta}
\setbeamercolor{date}{fg=tinta-suave}
\setbeamercolor{footline}{fg=tinta-suave}
\setbeamercolor{block title}{fg=uoc-azul, bg=uoc-cian-suave}
\setbeamercolor{block body}{fg=tinta, bg=superficie}
\setbeamercolor{itemize item}{fg=uoc-azul}

% Tipografía (Computer Modern sans, como en las figuras)
\setbeamerfont{frametitle}{family=\sffamily, series=\bfseries, size=\Large}
\setbeamerfont{title}{family=\sffamily, series=\bfseries, size=\huge}
\setbeamerfont{normal text}{family=\sffamily}
\renewcommand{\familydefault}{\sfdefault}
\setbeamertemplate{itemize item}{\raisebox{0.2ex}{\tikz\fill[uoc-azul](0,0) rectangle (1.2mm,1.2mm);}}
\setbeamertemplate{itemize subitem}{\textcolor{tinta-suave}{\textendash}}
\setbeamertemplate{itemize subsubitem}{\raisebox{0.3ex}{\tikz\fill[tinta-suave](0,0) rectangle (0.8mm,0.8mm);}}
\setbeamertemplate{enumerate item}{\textcolor{uoc-azul}{\insertenumlabel.}}
\setbeamertemplate{enumerate subitem}{\textcolor{uoc-azul}{\alph{enumii})}}
\setbeamertemplate{blocks}[default]

% Título de diapositiva con filete cian (como la cabecera de la memoria)
\setbeamertemplate{frametitle}{%
  \vspace{4mm}\usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}\insertframetitle\par
  \vspace{2mm}{\color{uoc-cian-filete}\rule{\linewidth}{3pt}}\par\vspace{1mm}}

% Pie: título corto a la izquierda, número a la derecha
\setbeamertemplate{footline}{%
  \hbox to \paperwidth{\hspace{10mm}\usebeamercolor[fg]{footline}\sffamily\scriptsize
  \insertshorttitle\hfill\insertframenumber\,/\,\inserttotalframenumber\hspace{10mm}}\vspace{4mm}}

% Portada: bloque cian a la izquierda, texto sobre papel
\setbeamertemplate{title page}{%
  \begin{tikzpicture}[remember picture, overlay]
    \fill[uoc-cian] (current page.north west) rectangle ([xshift=0.34\paperwidth]current page.south west);
    \fill[uoc-azul] ([xshift=0.34\paperwidth]current page.north west) rectangle ([xshift=0.34\paperwidth+3mm]current page.south west);
    \ifx\uoclogofile\empty\else
      \node[anchor=north west] at ([xshift=8mm, yshift=-8mm]current page.north west)
        {\includegraphics[width=0.22\paperwidth]{\uoclogofile}};
    \fi
  \end{tikzpicture}%
  \hspace*{0.34\paperwidth}\begin{minipage}{0.56\paperwidth}\raggedright
    {\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle\par}
    \vspace{3mm}{\usebeamercolor[fg]{subtitle}\large\insertsubtitle\par}
    \vspace{8mm}{\usebeamercolor[fg]{author}\insertauthor\par}
    \vspace{1mm}{\usebeamercolor[fg]{date}\small\insertinstitute\par\insertdate\par}
  \end{minipage}}

\mode<all>
