% ---------------------------------------------------------------- Gráfico circular
% \graficocircular[radio=18mm, hueco=9mm]{42/acc-accesible/Accesible, 27/acc-practicable/Practicable, ...}
% hueco>0 → anillo (donut); leyenda=true → leyenda a la derecha en vez de etiquetas (sectores < 5 %).
% Máximo 5 sectores; empieza a las 12 y gira en sentido horario.
\newif\iftfm@pieleyenda
\pgfkeys{/tfm/pie/.cd, radio/.store in=\tfm@pieR, hueco/.store in=\tfm@pieH, centro/.store in=\tfm@pieC,
  leyenda/.is choice, leyenda/true/.code={\tfm@pieleyendatrue}, leyenda/false/.code={\tfm@pieleyendafalse}}
\newcommand{\graficocircular}[2][]{%
  \pgfkeys{/tfm/pie/.cd, radio=18mm, hueco=0mm, centro={}, leyenda=false, #1}%
  \begin{tikzpicture}[tfm]
    \gdef\tfm@pieT{0}%
    \foreach \v/\c/\l in {#2}{\pgfmathparse{\tfm@pieT+\v}\xdef\tfm@pieT{\pgfmathresult}}%
    \gdef\tfm@pieA{90}%
    \foreach \v/\c/\l [count=\tfm@j from 0] in {#2}{%
      \def\tfm@i{\tfm@j}%
      \pgfmathsetmacro\tfm@d{\v/\tfm@pieT*360}%
      \pgfmathsetmacro\tfm@e{\tfm@pieA-\tfm@d}%
      \pgfmathsetmacro\tfm@m{\tfm@pieA-\tfm@d/2}%
      \pgfmathsetmacro\tfm@p{\v/\tfm@pieT*100}%
      \ifdim\tfm@pieH=0pt
        \fill[\c, draw=papel, line width=1pt] (0,0) -- (\tfm@pieA:\tfm@pieR) arc[start angle=\tfm@pieA, end angle=\tfm@e, radius=\tfm@pieR] -- cycle;
      \else
        \fill[\c, draw=papel, line width=1pt] (\tfm@pieA:\tfm@pieH) -- (\tfm@pieA:\tfm@pieR) arc[start angle=\tfm@pieA, end angle=\tfm@e, radius=\tfm@pieR] -- (\tfm@e:\tfm@pieH) arc[start angle=\tfm@e, end angle=\tfm@pieA, radius=\tfm@pieH] -- cycle;
      \fi
      \iftfm@pieleyenda
        \path (\tfm@pieR+6mm, \tfm@pieR-2mm) ++(0,{-5mm*\tfm@i}) node[muestra, fill=\c] (tfmsw) {}
          (tfmsw.east) node[anchor=west, font=\sffamily\scriptsize, text=tinta] {\l\ \ {\color{tinta-suave}\pgfmathprintnumber[fixed, precision=0]{\tfm@p}\,\%}};
      \else
        \draw[tinta-suave, line width=\trazofino] (\tfm@m:\tfm@pieR) -- (\tfm@m:\tfm@pieR+2.5mm);
        \node[font=\sffamily\scriptsize, text=tinta, align=center, anchor={\tfm@m+180}, inner sep=1.5pt]
          at (\tfm@m:\tfm@pieR+2.5mm) {\l\\{\color{tinta-suave}\pgfmathprintnumber[fixed, precision=0]{\tfm@p}\,\%}};
      \fi
      \xdef\tfm@pieA{\tfm@e}}%
    \ifx\tfm@pieC\empty\else\node[font=\sffamily\small\bfseries, text=uoc-azul, align=center] at (0,0) {\tfm@pieC};\fi
  \end{tikzpicture}}


% ---------------------------------------------------------------- Citas textuales
% Corta (< 40 palabras): en línea con \enquote{...} (csquotes) y la referencia: \enquote{texto}~\cite{x}
% Larga (≥ 40 palabras): bloque sangrado, sin comillas, fuente al pie.
%   \begin{citalarga}[Xie et al.~\cite{xie2021}, p.~3] texto \end{citalarga}
\newenvironment{citalarga}[1][]{%
  \def\tfm@citafuente{#1}%
  \par\medskip
  \begin{list}{}{\setlength{\leftmargin}{10mm}\setlength{\rightmargin}{10mm}\setlength{\topsep}{0pt}}
  \item[]\small\color{tinta}\ignorespaces}{%
  \ifx\tfm@citafuente\empty\else\par\nopagebreak\vspace{2pt}{\hfill\sffamily\footnotesize\color{tinta-suave}\textemdash\ \tfm@citafuente}\fi
  \end{list}\medskip\par}
% Norma o texto legal citado literalmente:
%   \begin{citanorma}{Orden TMA/851/2021, art.~5} texto literal \end{citanorma}
%   \begin{citanorma}[El subrayado es nuestro]{Referencia} ... \end{citanorma}
\newtcolorbox{tfm@normabox}[1]{enhanced, sharp corners, breakable,
  colback=superficie, colframe=uoc-azul, boxrule=0pt, toprule=1.2pt, bottomrule=0.4pt,
  leftrule=0pt, rightrule=0pt,
