% Línea temporal proporcional:
%   \lineatemporal[desde=2014, hasta=2024]{2015/FCN/Long et al., 2015/U-Net/Ronneberger et al., ...}
\pgfkeys{/tfm/lt/.cd, desde/.store in=\tfm@ltA, hasta/.store in=\tfm@ltB, ancho/.store in=\tfm@ltW, paso/.store in=\tfm@ltP}
\newcommand{\lineatemporal}[2][]{%
  \pgfkeys{/tfm/lt/.cd, desde=2014, hasta=2024, ancho=\linewidth, paso=2, #1}%
  \begin{tikzpicture}[tfm]
    \pgfmathsetmacro\tfm@ltU{(\tfm@ltW-8mm)/(\tfm@ltB-\tfm@ltA)}
    \draw[tinta-suave, line width=\trazo, -{Stealth[length=5pt]}] (0,0) -- ({(\tfm@ltB-\tfm@ltA)*\tfm@ltU pt+6mm},0);
    \pgfmathtruncatemacro\tfm@ltN{\tfm@ltA+\tfm@ltP}
    \foreach \y in {\tfm@ltA,\tfm@ltN,...,\tfm@ltB}{
      \draw[tinta-suave, line width=\trazofino] ({(\y-\tfm@ltA)*\tfm@ltU pt},-1mm) -- ++(0,2mm);
      \node[font=\sansmath\sffamily\scriptsize, text=tinta-suave, below=1.2mm] at ({(\y-\tfm@ltA)*\tfm@ltU pt},0) {\y};}
    \foreach \y/\t/\d [count=\i] in {#2}{
      \pgfmathsetmacro\tfm@x{(\y-\tfm@ltA)*\tfm@ltU}
      \pgfmathsetmacro\tfm@h{isodd(\i) ? 9 : 17}
      \draw[uoc-azul, line width=\trazofino] (\tfm@x pt,0) -- (\tfm@x pt,\tfm@h mm);
      \fill[uoc-azul] (\tfm@x pt,0) circle (1.1mm);
      \node[anchor=south west, inner sep=1pt, align=left, font=\sffamily\scriptsize, text=tinta]
        at (\tfm@x pt,\tfm@h mm) {\textbf{\t}\\{\color{tinta-suave}\d}};}
  \end{tikzpicture}}

