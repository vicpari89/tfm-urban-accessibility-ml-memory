% Escala gráfica para planos: \escalagrafica{(x,y)}{2}{2\,m}  (longitud en unidades del dibujo)
\newcommand{\escalagrafica}[3]{%
  \fill[tinta] #1 rectangle ++(#2/2,0.08); \fill[papel] #1 ++(#2/2,0) rectangle ++(#2/2,0.08);
  \draw[tinta, line width=0.4pt] #1 rectangle ++(#2,0.08);
  \node[font=\sffamily\tiny, text=tinta, above] at #1 {0};
  \node[font=\sffamily\tiny, text=tinta, above] at ($#1+(#2,0)$) {#3};}

% ---------------------------------------------------------------- Estados
% \estado{pendiente|en-curso|revision|completado|bloqueado}   \estado[Validado]{completado}
% Glifos tipo Harvey ball: vacío, medio, tres cuartos, lleno, cruz. Siempre con texto.
\@namedef{tfm@nombre@pendiente}{Pendiente}\@namedef{tfm@nombre@en-curso}{En curso}
\@namedef{tfm@nombre@revision}{En revisión}\@namedef{tfm@nombre@completado}{Completado}
\@namedef{tfm@nombre@bloqueado}{Bloqueado}
\expandafter\def\csname tfm@glifo@pendiente\endcsname#1{\draw[estado-pendiente, line width=0.8pt] #1 circle (0.95mm);}
\expandafter\def\csname tfm@glifo@en-curso\endcsname#1{\draw[estado-en-curso, line width=0.8pt] #1 circle (0.95mm);
  \fill[estado-en-curso] #1 -- ++(90:0.95mm) arc[start angle=90, end angle=-90, radius=0.95mm] -- cycle;}
\expandafter\def\csname tfm@glifo@revision\endcsname#1{\draw[estado-revision, line width=0.8pt] #1 circle (0.95mm);
  \fill[estado-revision] #1 -- ++(90:0.95mm) arc[start angle=90, end angle=-180, radius=0.95mm] -- cycle;}
\expandafter\def\csname tfm@glifo@completado\endcsname#1{\fill[estado-completado] #1 circle (1.2mm);}
\expandafter\def\csname tfm@glifo@bloqueado\endcsname#1{\fill[estado-bloqueado] #1 circle (1.2mm);
  \draw[papel, line width=0.8pt] #1 ++(-0.55mm,-0.55mm) -- ++(1.1mm,1.1mm) #1 ++(-0.55mm,0.55mm) -- ++(1.1mm,-1.1mm);}
\DeclareRobustCommand{\estado}[2][]{%
  \tikz[baseline=(tfmest.base)]{%
    \node[draw=estado-#2, fill=estado-#2-fondo, line width=0.6pt, rounded corners=1.5pt,
          inner xsep=3pt, inner ysep=1.5pt, font=\sffamily\footnotesize, text=tinta]
      (tfmest) {\hspace{3.6mm}\ifx\relax#1\relax\csname tfm@nombre@#2\endcsname\else#1\fi};
    \csname tfm@glifo@#2\endcsname{([xshift=4.2pt]tfmest.west)}}}
% Glifo solo (tablas densas; acompáñalo de leyenda)
\DeclareRobustCommand{\glifoestado}[1]{\tikz[baseline=-0.6ex]{\csname tfm@glifo@#1\endcsname{(0,0)}}}
% Marca de borrador en el margen del texto: \estadobloque{revision}{Falta revisar cifras}
% Con \usepackage[final]{tfm-estilo} desaparecen todas.
\newcommand{\estadobloque}[2]{\iftfm@final\else\par\noindent{\estado{#1}\hspace{4pt}{\sffamily\footnotesize\color{tinta-suave}#2}}\par\smallskip\fi}

% ---------------------------------------------------------------- Kanban
% \begin{kanban} \kanbancolumna{Pendiente}{\tarjeta{Título}{pendiente}{Detalle}...} ... \end{kanban}
\newlength{\tfm@kanbanancho}
\newenvironment{kanban}[1][4]{\par\noindent\setlength{\tfm@kanbanancho}{\dimexpr(\linewidth-6pt*\numexpr#1-1\relax)/#1\relax}}{\par}
\newcommand{\kanbancolumna}[2]{%
  \begin{minipage}[t]{\tfm@kanbanancho}%
    \setlength{\fboxsep}{4pt}%
    \colorbox{uoc-cian-suave}{\parbox{\dimexpr\linewidth-2\fboxsep}{\sffamily\small\bfseries\color{uoc-azul}#1}}\par\vspace{4pt}%
    #2%
  \end{minipage}\hspace{6pt}\ignorespaces}
\newcommand{\tarjeta}[3]{%
  {\setlength{\fboxsep}{4pt}\setlength{\fboxrule}{0.6pt}%
   \fcolorbox{tinta-suave}{papel}{\parbox{\dimexpr\linewidth-2\fboxsep-2\fboxrule}{\raggedright\sffamily\scriptsize
     {\footnotesize\bfseries #1}\par\smallskip\estado{#2}\ifx\relax#3\relax\else\par\smallskip{\color{tinta-suave}#3}\fi}}}\par\vspace{4pt}}

% ---------------------------------------------------------------- Tablas de requisitos (cap. 02-02)
% Tabla de requisitos con formato: parámetro | requisito | artículo
