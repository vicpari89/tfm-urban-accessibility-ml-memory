\colorlet{tfm@recfondo@atencion}{estado-en-curso-fondo}\colorlet{tfm@recborde@atencion}{estado-en-curso}\colorlet{tfm@rectit@atencion}{tinta}% papel sobre ámbar no llega a 4,5:1
