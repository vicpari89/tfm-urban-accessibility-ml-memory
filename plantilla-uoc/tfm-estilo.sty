%   Opcional: ancho relativo \citadestacada[0.7]{...}{...}  (por defecto 0.82)
\newcommand{\citadestacada}[3][0.82]{%
  \par\bigskip
  \begin{center}
  \begin{minipage}{#1\linewidth}
    {\color{uoc-cian-filete}\rule{\linewidth}{1mm}}\par\medskip
    {\centering\large\itshape\color{uoc-azul}\enquote{#2}\par}
    \smallskip
    {\raggedleft\sffamily\footnotesize\color{tinta-suave}\textemdash\ #3\par}
    \medskip{\color{uoc-cian-filete}\rule{\linewidth}{1mm}}
  \end{minipage}
  \end{center}
  \bigskip}
