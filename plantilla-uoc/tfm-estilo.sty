  % Barras verticales agrupadas
  tfmbarras/.style={tfm, ybar, bar width=6pt, cycle list name=tfmbarras,
    xtick=data, enlarge x limits=0.08, xticklabel style={rotate=0}},
  % Barras horizontales agrupadas (primera categoría arriba)
  tfmbarrash/.style={tfm, xbar, bar width=5pt, cycle list name=tfmbarras,
    ytick=data, y dir=reverse, enlarge y limits=0.12, ymajorgrids=false, xmajorgrids},
  % Barras apiladas vertical / horizontal (usa cycle list name=tfmaccesibilidad para clases)
  tfmapiladas/.style={tfm, ybar stacked, bar width=14pt, cycle list name=tfmbarras,
    xtick=data, enlarge x limits=0.12},
  tfmapiladash/.style={tfm, xbar stacked, bar width=10pt, cycle list name=tfmbarras,
    ytick=data, y dir=reverse, enlarge y limits=0.15, ymajorgrids=false, xmajorgrids},
  % Líneas en orientación vertical (perfiles: variable en x, posición/profundidad en y)
  tfmlineasv/.style={tfm, ymajorgrids=false, xmajorgrids, y dir=reverse},
  % Dispersión (comparar artículos: p. ej. mIoU frente a parámetros); etiquetas con point meta
  tfmdispersion/.style={tfm, only marks, xmajorgrids, mark size=2.2pt,
    nodes near coords*={\label}, visualization depends on={value \thisrow{etiqueta}\as\label},
    every node near coord/.append style={font=\sffamily\scriptsize, text=tinta, anchor=west, xshift=1pt}},
  % Etiquetas de valor sobre barras (opcional)
  valores/.style={nodes near coords, every node near coord/.append style={font=\sansmath\sffamily\scriptsize, text=tinta}},
}

