% Glosario en formato bib2gls
% Entradas de términos y siglas para la tesis

@entry{accesibilidad-universal,
  name = {Accesibilidad universal},
  text = {accesibilidad universal},
  description = {Condición de no discriminación de cualquier persona, permitiendo la autonomía propia, derechos y disfrute de su entorno, independientemente de tener diversidad funcional o no}
}

@entry{altura-libre-paso,
  name = {Altura libre de paso},
  text = {altura libre de paso},
  description = {Altura mínima del trayecto peatonal, de 2,20 metros, durante el que las personas pueden circular sin riesgo de impacto contra elementos situados superiormente (Orden TMA/851/2021, artículo 5.2.c)}
}

@entry{ancho-libre-paso,
  name = {Ancho libre de paso},
  text = {ancho libre de paso},
  description = {Banda de un itinerario peatonal que permite una circulación continua a las personas, con una dimensión mínima de 1,80 metros, sin ningún obstáculo en la totalidad de su recorrido (Orden TMA/851/2021, artículo 5.2.b)}
}

@entry{avisador-acustico,
  name = {Avisador acústico},
  text = {avisador acústico},
  description = {Dispositivo sonoro de un semáforo que indica a las personas con discapacidad visual cuándo es posible cruzar la calzada}
}

@entry{clase-accesibilidad,
  name = {Clase de accesibilidad},
  text = {clase de accesibilidad},
  description = {Categoría que contiene el nivel de accesibilidad de una calle o tramo a partir de la puntuación obtenida}
}

@entry{continuidad,
  name = {Continuidad del itinerario},
  text = {continuidad del itinerario},
  description = {Característica que garantiza que el recorrido peatonal no tenga interrupciones ni obstáculos que obliguen a cambiar de trayectoria. Es esencial para la autonomía de personas ciegas y con baja visión (Orden TMA/851/2021, artículo 5.2.a)}
}

@entry{continuidad-via,
  name = {Continuidad de la vía},
  text = {continuidad de la vía},
  description = {Condición de un itinerario peatonal accesible que debe permanecer sin interrupciones ni obstáculos en todo su recorrido, manteniendo uniformidad tanto horizontal como vertical para garantizar el tránsito seguro de todas las personas}
}

@entry{cruce-peatonal,
  name = {Cruce peatonal},
  text = {cruce peatonal},
  description = {Área de la calzada destinada al cruce seguro de peatones, suficientemente señalizada y delimitada para garantizar la visibilidad y la protección de los viandantes (Orden TMA/851/2021, artículo 21)}
}

@abbreviation{DALCO,
  short = {DALCO},
  long = {Deambulación, Aprehensión, Localización y Comunicación},
  description = {Marco de la norma UNE 170001-1 que agrupa en cuatro acciones (desplazarse, coger o asir, averiguar un lugar e intercambiar información) los requisitos que debe cumplir el entorno para ser universalmente accesible}
}

@entry{deep-learning,
  name = {Deep learning},
  text = {deep learning},
  description = {Campo del machine learning basado en redes neuronales con múltiples capas, capaz de aprender a reconocer automáticamente elementos complejos en imágenes, optimizando la matriz de pesos del modelo}
}

@entry{desnivel-resalte,
  name = {Desnivel y resalte},
  text = {desnivel y resalte},
  description = {Cambio de nivel en el pavimento o elemento que sobresale del mismo. Un desnivel superior a 4 milímetros constituye un obstáculo para personas con movilidad reducida o usuarios de silla de ruedas}
}

@entry{dimension-accesibilidad,
  name = {Dimensión de accesibilidad},
  text = {dimensión de accesibilidad},
  description = {Subdivisión de la accesibilidad del viario urbano que se evalúa de forma independiente a partir de los requisitos de la Orden TMA/851/2021, como la pendiente, la anchura, el pavimento, los cruces, la señalización, la iluminación, el mobiliario o el transporte}
}

@entry{diseno-para-todos,
  name = {Diseño para todos},
  text = {diseño para todos},
  description = {Concepto de diseño por el que desde el principio se tiene en cuenta la diversidad de toda la población en materia de utilización y disfrute de los entornos}
}

@entry{diversidad-funcional,
  name = {Diversidad funcional},
  text = {diversidad funcional},
  description = {Concepto que define el conjunto de la sociedad con capacidades diversas (física, visual, auditiva, cognitiva o relacional) y que tiene en cuenta a todas las personas independientemente de sus capacidades. Sustituye al término discapacidad, con una connotación más social}
}

@entry{extraccion-geometrica,
  name = {Extracción geométrica},
  text = {extracción geométrica},
  description = {Procedimiento que utiliza como entrada las máscaras de predicción de la segmentación semántica para obtener medidas reales (como metros) y calcular dimensiones a partir de operaciones vectoriales}
}

@abbreviation{GIS,
  short = {GIS},
  long = {Geographic Information System},
  description = {Herramienta tecnológica que gestiona información espacial y cartográfica, permitiendo integrar diferentes capas vectoriales para su análisis y representación en mapas}
}

@entry{github,
  name = {GitHub},
  description = {Plataforma basada en Git que actúa como repositorio de código fuente, que se utiliza para el control de versiones y la gestión del ciclo de vida del proyecto}
}

@abbreviation{GPU,
  short = {GPU},
  long = {Graphics Processing Unit},
  description = {Unidad de procesamiento que permite la aceleración por hardware y el cálculo masivo en paralelo, vital para el entrenamiento e inferencia de redes neuronales}
}

@entry{ground-truth,
  name = {Ground Truth},
  text = {ground Truth},
  description = {Conjunto de datos reales de referencia, que pueden obtenerse mediante observaciones de campo, con los que poder evaluar la calidad y precisión de las predicciones de un modelo}
}

@entry{hipoacusia,
  name = {Hipoacusia},
  text = {hipoacusia},
  description = {Disminución de la capacidad auditiva, de grado leve a severo. Afecta a la recepción de información sonora, como los avisos acústicos o los mensajes de megafonía}
}

@entry{inspeccion-in-situ,
  name = {Inspección \emph{in situ}},
  text = {inspección \emph{in situ}},
  description = {Visita presencial al lugar para tomar medidas y observar directamente las condiciones de accesibilidad, en contraposición a la obtención de datos a partir de imágenes}
}

@abbreviation{IPA,
  short = {IPA},
  long = {Itinerario peatonal accesible},
  description = {Itinerario con un flujo de paso continuo de al menos 1,80 metros de ancho y 2,20 metros de alto que permite la circulación a cualquier persona de forma segura, cómoda y autónoma (Orden TMA/851/2021, artículo 5.1)}
}

@entry{isleta-refugio,
  name = {Isleta de refugio},
  text = {isleta de refugio},
  description = {Área intermedia situada en la calzada que permite a los peatones cruzar en dos fases, sirviendo como lugar seguro de espera. Es obligatoria en cruces cuya distancia sea mayor a 14 metros (Orden TMA/851/2021, artículo 22)}
}

@entry{itinerario-alternativo,
  name = {Itinerario alternativo accesible},
  text = {itinerario alternativo accesible},
  description = {Ruta secundaria que proporciona accesibilidad cuando el itinerario peatonal habitual no puede mantenerse, como en zonas de obras o en estructuras provisionales. Debe cumplir las mismas condiciones que un itinerario permanente (Orden TMA/851/2021, artículo 39)}
}

@entry{kanban,
  name = {Kanban},
  description = {Metodología ágil de gestión de proyectos que utiliza un flujo de tareas por estados (pendiente, en proceso, en pruebas o finalizado), que permite visualizar y organizar el desarrollo de un trabajo o proyecto}
}

@entry{machine-learning,
  name = {Machine learning},
  text = {machine learning},
  description = {Parte de la inteligencia artificial centrada en el desarrollo de modelos que permiten aprender a partir de conjuntos de datos y hacer predicciones o decisiones basadas en ellos}
}

@entry{mobiliario-urbano,
  name = {Mobiliario urbano},
  text = {mobiliario urbano},
  description = {Conjunto de elementos instalados en los espacios públicos urbanizados (bancos, papeleras, bolardos, señales, luminarias, etc.) cuya ubicación y diseño deben garantizar la accesibilidad y no invadir el itinerario peatonal accesible (Orden TMA/851/2021, artículo 25)}
}

@entry{movilidad-reducida,
  name = {Movilidad reducida},
  text = {movilidad reducida},
  description = {Persona que tiene una limitación en su movilidad que le afecta en sus desplazamientos de manera funcional. Entre otros, incluye a usuarios/as de silla de ruedas o personas mayores}
}

@entry{movilidad-reducida-temporal,
  name = {Movilidad reducida temporal},
  text = {movilidad reducida temporal},
  description = {Persona que tiene movilidad reducida durante un periodo transitorio. Se incluyen: personas con muletas, lesiones o familias con carritos de bebé}
}

@abbreviation{MVP,
  short = {MVP},
  long = {Producto Mínimo Viable},
  description = {Mínima unidad de entrega de un producto que contiene los objetivos fundamentales y esenciales del mismo, que permite ofrecer una funcionalidad mínima en un periodo corto de tiempo}
}

@entry{orden-tma-851-2021,
  name = {Orden TMA/851/2021},
  description = {Regulación estatal marco que establece las condiciones mínimas de accesibilidad en vías urbanas, y que define las características mínimas para considerar una vía accesible y la normativa sobre plataformas únicas. Sustituye a la Orden VIV/561/2010}
}

@abbreviation{PAU,
  short = {PAU},
  long = {Plan de accesibilidad universal},
  description = {Instrumento técnico de diagnóstico de la accesibilidad municipal, que debe incluir un informe con el listado de barreras en la vía urbana, priorización de actuaciones y un plan de actuación y presupuestario}
}

@entry{pavimento-tactil,
  name = {Pavimento táctil},
  text = {pavimento táctil},
  description = {Superficie especial con relieves detectables al tacto que proporciona información a personas con discapacidad visual sobre cambios de nivel, peligros o direcciones de circulación. Puede ser de advertencia (con botones o franjas) o de encaminamiento (con líneas direccionales)}
}

@entry{pendiente-longitudinal,
  name = {Pendiente longitudinal},
  text = {pendiente longitudinal},
  description = {Inclinación del itinerario peatonal, expresada en porcentaje, en la dirección de la marcha o sentido de circulación, con un máximo permitido del 6\% (Orden TMA/851/2021, artículo 5.2.g)}
}

@entry{pendiente-transversal,
  name = {Pendiente transversal},
  text = {pendiente transversal},
  description = {Inclinación del itinerario peatonal, expresada en porcentaje, perpendicular a la dirección de la marcha, con un máximo permitido del 2\% (Orden TMA/851/2021, artículo 5.2.f)}
}

@entry{plataforma-unica,
  name = {Plataforma única},
  text = {plataforma única},
  description = {Espacio urbano en el que peatones y vehículos conviven sin diferencia de nivel, diferenciándose únicamente mediante pavimentos, texturas, colores o mobiliario. Puede ser de tránsito compartido (toda la superficie de prioridad peatonal) o diferenciado (con zonas legales distintas)}
}

@entry{segmentacion-semantica,
  name = {Segmentación semántica},
  text = {segmentación semántica},
  description = {Técnica de visión por computador capaz de detectar clases semánticas a partir de una imagen digital (acera, calzada, vehículo, vegetación o mobiliario), clasificando píxel a píxel y utilizando máscaras de predicción}
}

@entry{senalizacion,
  name = {Señalización},
  text = {señalización},
  description = {Sistema de comunicación y señalización que contiene elementos visuales, sonoros o táctiles a disposición de las personas en espacios públicos urbanizados. Incluye señalización visual con macrocaracteres y alto contraste, señalización táctil con información en Braille y altorrelieve, y señalización sonora con avisos acústicos para alertar sobre peligros o cambios en el entorno}
}

@abbreviation{SIG,
  short = {SIG},
  long = {Sistema de información geográfica},
  description = {Herramienta tecnológica que gestiona información espacial y cartográfica, permitiendo integrar diferentes capas vectoriales para su análisis y representación en mapas}
}

@entry{transfer-learning,
  name = {Transfer learning},
  text = {transfer learning},
  description = {Técnica del deep learning que reutiliza modelos preentrenados que funcionan bien en tareas generales, que realiza un ajuste de pesos llamado \textit{fine-tuning} para la especialización de un problema específico, optimizando el tiempo de entrenamiento}
}

@entry{vado-peatonal,
  name = {Vado peatonal},
  text = {vado peatonal},
  description = {Área de la acera destinada al inicio del cruce peatonal, habilitando un acceso seguro a la calzada mediante una inclinación suave para salvar el desnivel entre acera y calzada (Orden TMA/851/2021, artículo 20)}
}

@entry{vision-computacional,
  name = {Visión computacional},
  text = {visión computacional},
  description = {Subconjunto de la inteligencia artificial especializado en el procesamiento y análisis automático de imágenes digitales, permitiendo la extracción de información semántica estructurada a partir de la naturaleza desestructurada de las imágenes}
}

@entry{visor-sig,
  name = {Visor SIG},
  text = {visor SIG},
  description = {Interfaz gráfica interactiva que representa datos en un mapa, permitiendo la visualización y consulta de elementos geográficos al usuario}
}

@abbreviation{ADA,
  short = {ADA},
  long = {Americans with Disabilities Act},
  description = {Ley federal de Estados Unidos de 1990 que prohíbe la discriminación por discapacidad y establece requisitos de accesibilidad para el espacio público, como pendientes máximas y anchuras mínimas de las aceras}
}

@abbreviation{SQI,
  short = {SQI},
  long = {índice de calidad de aceras},
  description = {\emph{Sidewalk Quality Index}: índice que resume la calidad de una acera a partir de la existencia, el estado y la seguridad de sus características, utilizado en los estudios de Georgia Tech}
}

@entry{caminabilidad,
  name = {Caminabilidad},
  text = {caminabilidad},
  description = {\emph{Walkability}: grado en que un entorno urbano resulta favorable para desplazarse a pie, atendiendo a su seguridad, comodidad y conectividad}
}

@entry{logica-difusa,
  name = {Lógica difusa},
  text = {lógica difusa},
  description = {\emph{Fuzzy logic}: forma de razonar que admite respuestas intermedias en lugar de solo «sí» o «no». Permite, por ejemplo, decir que una acera es accesible «en parte» y dar a esa valoración un valor numérico entre 0 y 1}
}

@entry{fuzzy-topsis,
  name = {Fuzzy-TOPSIS},
  text = {Fuzzy-TOPSIS},
  description = {Método para decidir entre varias opciones con criterios distintos: cuanto más se parece una opción a la mejor situación posible y más se aleja de la peor, mejor puntuación recibe. Incorpora lógica difusa para manejar datos imprecisos}
}

@entry{auditoria-virtual,
  name = {Auditoría virtual},
  text = {auditoría virtual},
  description = {Evaluación de la accesibilidad de una vía a partir de imágenes a pie de calle, sin necesidad de desplazarse al lugar, en contraposición a la inspección \emph{in situ}}
}

@entry{arbol-decision,
  name = {Árbol de decisión},
  text = {árbol de decisión},
  description = {Modelo que clasifica un tramo respondiendo a una serie de preguntas encadenadas sobre sus variables (por ejemplo, «¿El ancho es mayor a 1,80m?»), de modo que cada rama termina en una clase}
}

@entry{random-forest,
  name = {Random forest},
  text = {random forest},
  description = {Modelo formado por muchos árboles de decisión entrenados con distintas muestras de los datos, cuya clasificación final se obtiene por votación}
}

@entry{gradient-boosting,
  name = {Gradient boosting},
  text = {gradient boosting},
  description = {Técnica que construye los árboles de decisión uno tras otro, de manera que cada árbol corrige los errores del anterior. Ejemplos de implementación: XGBoost y LightGBM}
}

@entry{regresion-logistica,
  name = {Regresión logística},
  text = {regresión logística},
  description = {Modelo lineal que calcula la probabilidad de que un tramo pertenezca a una clase a partir de una combinación ponderada de sus variables}
}

@entry{clase-ordinal,
  name = {Clase ordinal},
  text = {clase ordinal},
  description = {Variable objetivo cuyas categorías siguen un orden (en este trabajo A, B y C), de modo que confundir A con C es un error más grave que confundir A con B}
}

@entry{desbalanceo-clases,
  name = {Desbalanceo de clases},
  text = {desbalanceo de clases},
  description = {Situación en la que unas clases tienen muchos menos ejemplos que otras, lo que lleva al modelo a favorecer a la clase mayoritaria}
}

@entry{ponderacion-clases,
  name = {Ponderación de clases},
  text = {ponderación de clases},
  description = {Técnica para tratar el desbalanceo que da más peso en el entrenamiento a los errores cometidos en las clases poco frecuentes. Es la base del aprendizaje sensible al coste}
}

@entry{submuestreo,
  name = {Submuestreo},
  text = {submuestreo},
  description = {Técnica para tratar el desbalanceo que reduce el número de ejemplos de las clases mayoritarias hasta equilibrarlas con las minoritarias. Su opuesto es el sobremuestreo, que genera ejemplos sintéticos de las clases minoritarias}
}

@entry{f1-macro,
  name = {F1 macro},
  text = {F1 macro},
  description = {Métrica que calcula el F1 de cada clase (media armónica de la precisión y el \textit{recall}) y promedia los resultados, de modo que todas las clases pesan igual con independencia de su tamaño}
}

@entry{exactitud-balanceada,
  name = {Exactitud balanceada},
  text = {exactitud balanceada},
  description = {Media de la proporción de aciertos de cada clase, que evita que la clase mayoritaria domine el resultado, a diferencia de la exactitud global}
}

@entry{kappa-ponderada,
  name = {Kappa ponderada cuadrática},
  text = {kappa ponderada cuadrática},
  description = {Métrica de concordancia entre la clase real y la predicha para clases ordinales, que penaliza los errores en proporción al cuadrado de la distancia entre clases}
}

@entry{importancia-permutacion,
  name = {Importancia por permutación},
  text = {importancia por permutación},
  description = {Medida de la importancia de una variable que consiste en desordenar sus valores y observar cuánto empeora la métrica del modelo}
}

@entry{shap,
  name = {SHAP},
  text = {SHAP},
  description = {\textit{SHapley Additive exPlanations}: método basado en la teoría de juegos que reparte la predicción del modelo entre las variables, calculando la contribución media de cada una}
}

@entry{indice-gini,
  name = {Índice de Gini},
  text = {índice de Gini},
  description = {Medida de la homogeneidad de las clases dentro de un grupo. En los árboles de decisión sirve para medir la importancia de una variable según cuánto reduce esa impureza al dividir los datos}
}

@abbreviation{GBDT,
  short = {GBDT},
  long = {Gradient Boosting Decision Trees},
  description = {Familia de modelos de árboles de decisión entrenados mediante \emph{gradient boosting}, en los que cada árbol corrige los errores de los anteriores}
}

@abbreviation{IAA,
  short = {IAA},
  long = {Impact-Asymmetry Analysis},
  description = {Análisis que clasifica cada atributo en clases ordinales según el impacto}
}

@abbreviation{MOTC,
  short = {MOTC},
  long = {Multi-Output Tree Chaining},
  description = {Método de modelo único con varias salidas que encadena árboles para aprovechar las dependencias entre las variables objetivo}
}

@abbreviation{MTBR,
  short = {MTBR},
  long = {Multi-Target Boosting for Regression},
  description = {Extensión de \emph{gradient boosting} que predice varias variables objetivo continuas a la vez}
}

@abbreviation{RRMSE,
  short = {RRMSE},
  long = {Relative Root Mean Squared Error},
  description = {Error cuadrático medio relativo: error de un modelo dividido entre el de una predicción de referencia (la media), lo que permite comparar variables objetivo de distinta escala}
}

@abbreviation{CRRMSE,
  short = {CRRMSE},
  long = {Combined Relative Root Mean Squared Error},
  description = {Error cuadrático medio relativo comparado entre varias variables objetivo, obtenido a partir de los RRMSE de cada una}
}

@abbreviation{SVR,
  short = {SVR},
  long = {Support Vector Regression},
  description = {Modelo de regresión basado en máquinas de vectores de soporte, que ajusta una función tolerando un margen de error alrededor de las predicciones}
}

@abbreviation{RFR,
  short = {RFR},
  long = {Random Forest Regressor},
  description = {Versión de \emph{random forest} para variables objetivo continuas, que promedia las predicciones de sus árboles}
}

@abbreviation{MAE,
  short = {MAE},
  long = {Mean Absolute Error},
  description = {Error absoluto medio: promedio de las diferencias, en valor absoluto, entre el valor real y el predicho}
}

@abbreviation{MSE,
  short = {MSE},
  long = {Mean Squared Error},
  description = {Error cuadrático medio: promedio de los cuadrados de las diferencias entre el valor real y el predicho, que penaliza más los errores grandes}
}

@abbreviation{RMSE,
  short = {RMSE},
  long = {Root Mean Squared Error},
  description = {Raíz del error cuadrático medio: raíz cuadrada del MSE, expresada en las mismas unidades que la variable objetivo}
}

@entry{particion-aleatoria,
  name = {Partición aleatoria},
  text = {partición aleatoria},
  description = {Estrategia de validación que divide al azar los datos en conjuntos de entrenamiento y de test, sin tener en cuenta su ubicación}
}

@entry{validacion-agrupada,
  name = {Validación agrupada},
  text = {validación agrupada},
  description = {Estrategia de validación en la que los datos se agrupan (por calle, barrio o distrito) y cada grupo completo va a entrenamiento o a test, de modo que el modelo se evalúa sobre zonas que no ha visto}
}

@entry{validacion-entre-ciudades,
  name = {Validación entre ciudades},
  text = {validación entre ciudades},
  description = {Estrategia de validación que entrena el modelo con los datos de una o varias ciudades y lo evalúa en otra distinta, para medir su capacidad de generalizar}
}

@entry{fine-tuning,
  name = {\emph{Fine tuning}},
  text = {fine tuning},
  description = {Ajuste de un modelo ya entrenado con datos nuevos, normalmente con pocos datos y pocas iteraciones, para adaptarlo a otro dominio, como una ciudad distinta}
}

@entry{recall,
  name = {\emph{Recall}},
  text = {recall},
  description = {Proporción de los casos positivos reales que el modelo detecta correctamente, es decir, cuántos problemas existentes se encuentran}
}

@entry{precision,
  name = {Precisión},
  text = {precisión},
  description = {Proporción de las predicciones positivas del modelo que son correctas, es decir, cuántos de los problemas señalados existen realmente}
}

@entry{matriz-confusion,
  name = {Matriz de confusión},
  text = {matriz de confusión},
  description = {Tabla que cruza las clases reales con las predichas y muestra cuántos casos se clasifican bien y cuáles se confunden entre sí}
}

@entry{accuracy,
  name = {\emph{Accuracy}},
  text = {accuracy},
  description = {Proporción de predicciones correctas sobre el total de casos}
}
