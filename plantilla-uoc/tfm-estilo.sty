% ---------------------------------------------------------------- Real frente a predicho
% Convención: «sobreestima» = la predicción da más de lo real (más ancho, más accesible, píxel
% predicho que no existe: falso positivo) → naranja; «subestima» = se queda corta (falso negativo) → azul.
\newlength{\tfm@tol}\setlength{\tfm@tol}{0pt}
\def\tfm@tolval{0.3}
\newcommand{\tolerancia}[1]{\def\tfm@tolval{#1}}   % \tolerancia{0.3} (en las unidades de la tabla)
% Error con signo en tablas: \errorval{0.12} → +0,12 ; fuera de tolerancia: negrita + glifo
\DeclareRobustCommand{\errorval}[1]{%
  \pgfmathparse{abs(#1)>\tfm@tolval ? 1 : 0}%
  \ifnum\pgfmathresult=1\relax
    \pgfmathparse{#1>0 ? 1 : 0}%
    \ifnum\pgfmathresult=1\relax\textcolor{error-sobreestima}{\tikz[baseline=-0.6ex]\fill (0,0.9mm)--(0.9mm,-0.7mm)--(-0.9mm,-0.7mm)--cycle;}\else\textcolor{error-subestima}{\tikz[baseline=-0.6ex]\fill (0,-0.9mm)--(0.9mm,0.7mm)--(-0.9mm,0.7mm)--cycle;}\fi
    \,\textbf{\pgfmathprintnumber[fixed, fixed zerofill, precision=2, showpos, use comma]{#1}}%
  \else
    \pgfmathprintnumber[fixed, fixed zerofill, precision=2, showpos, use comma]{#1}%
  \fi}
% Clase real frente a predicha (1 = Accesible … 4 = No accesible): \comparaclase{2}{1}
\DeclareRobustCommand{\comparaclase}[2]{%
  \pgfmathtruncatemacro\tfm@dc{#2-#1}%
  \ifnum\tfm@dc=0\relax{\sffamily\footnotesize\color{error-acierto}= acierto}%
  \else\ifnum\tfm@dc<0\relax{\sffamily\footnotesize\bfseries\color{error-sobreestima}$\blacktriangle$\,sobreestima \the\numexpr-\tfm@dc\relax}%
  \else{\sffamily\footnotesize\bfseries\color{error-subestima}$\blacktriangledown$\,subestima \tfm@dc}\fi\fi}
\providecommand{\blacktriangle}{\mbox{\tikz\fill (0,0)--(1.8mm,0)--(0.9mm,1.6mm)--cycle;}}
\providecommand{\blacktriangledown}{\mbox{\tikz\fill (0,1.6mm)--(1.8mm,1.6mm)--(0.9mm,0)--cycle;}}
\tikzset{
  % gráficos: diagonal y = x, banda de tolerancia y pesas (dumbbell) real → predicho
  diagonal/.style={draw=serie-base, line width=\trazo, dashed},
  bandatolerancia/.style={fill=error-tolerancia, draw=none},
  pesareal/.style={draw=tinta, fill=papel, line width=0.8pt},
  pesapredicho/.style={fill=serie-1, draw=serie-1},
  pesaunion/.style={draw=tinta-suave, line width=\trazo},
  % mapas de error por tramo y máscaras de error
  tramoacierto/.style={tramo, error-acierto, line width=1.5pt},
  tramosobre/.style={tramo, error-sobreestima},
  tramosub/.style={tramo, error-subestima, dash pattern=on 5pt off 2pt},
}
% Dispersión real/predicho: \begin{axis}[tfmrealpredicho, xmin=0, xmax=4, ymin=0, ymax=4] ... \end{axis}
\pgfplotsset{tfmrealpredicho/.style={tfm, only marks, xmajorgrids, axis equal image,
  mark=*, mark size=1.8pt, mark options={fill=serie-1, draw=papel, line width=0.3pt},
  xlabel={Valor real}, ylabel={Valor predicho}}}



